+    out = [0.0]
+    for index in range(1, int(n_path)):
+        if index < len(pts):
+            ds = math.hypot(
+                pts[index][0] - pts[index - 1][0],
+                pts[index][1] - pts[index - 1][1],
+            )
+        elif len(pts) >= 2:
+            ds = math.hypot(
+                pts[-1][0] - pts[-2][0],
+                pts[-1][1] - pts[-2][1],
+            )
+        else:
+            ds = 1.0
+        ds = max(1.0e-4, min(float(ds), 3.0))
+        out.append(math.log(math.expm1(ds)))
+    return tuple(out)
