+
+    def _value(name: str) -> Any:
+        value = obs.get(name) if isinstance(obs, Mapping) else None
+        return sample.get(name) if value is None else value
+
+    lon = _value("actor_lon_m")
+    lat = _value("actor_lat_m")
+    speed = _value("actor_speed_mps")
+    return {
+        "actor_present": lon is not None and lat is not None and speed is not None,
+        "actor_lon_m": lon,
+        "actor_lat_m": lat,
