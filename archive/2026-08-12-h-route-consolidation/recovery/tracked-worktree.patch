+def _resolve_ready_host(args: argparse.Namespace) -> None:
+    """Bind live commands to the endpoint that passed the unified preflight.
+
+    The WSL-to-Windows route can change between launches (for example from
+    loopback to the WSL gateway proxy).  A fixed client default can therefore
+    reach the TCP port while sending CARLA RPCs to the wrong endpoint.  Keep an
+    explicit ``--host`` override for diagnostics, but otherwise require the
+    read-only resolver to return READY and reuse its exact endpoint for every
+    client in this process.
+    """
+
+    explicit = str(getattr(args, "host", "") or "").strip() or None
+    port = int(getattr(args, "port", 2000) or 2000)
+    resolver = ConnectionResolver(ROOT, timeout_seconds=10.0)
+    report = resolver.preflight(host=explicit, port=port)
+    if report.status != READY or not report.host:
+        raise RuntimeError(
+            "CARLA preflight is not READY: "
+            f"status={report.status} error={report.error_code} "
+            f"message={report.error_message}"
+        )
+    args.host = str(report.host)
+    args.port = int(report.port)
+    # Preserve the structured endpoint evidence for callers that freeze a
+    # manifest or report, without changing the existing command-line schema.
+    args.carla_preflight = report.to_dict()
+
+
