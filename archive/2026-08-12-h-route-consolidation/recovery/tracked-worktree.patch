+def observable_scene_vector(
+    scene: Mapping[str, Any] | None,
+    *,
+    ego_v: float,
+) -> list[float]:
+    """Encode candidate-blind current actor state into eight bounded values.
+
+    These values are observable at the decision instant.  No family label,
+    candidate identity, oracle outcome, or future state is accepted.  The
+    vector occupies previously padded geometry-context slots so the 96-wide
+    checkpoint ABI remains compatible with earlier heads.
+    """
+    src = dict(scene or {})
+    present = bool(src.get("actor_present", False))
+    lon_raw = src.get("actor_lon_m")
+    lat_raw = src.get("actor_lat_m")
+    speed_raw = src.get("actor_speed_mps")
+    if lon_raw is None or lat_raw is None or speed_raw is None:
+        present = False
+    if not present:
+        return [0.0] * OBSERVABLE_SCENE_DIM
+    lon = float(lon_raw)
+    lat = float(lat_raw)
+    actor_v = max(0.0, float(speed_raw))
+    rel_v = float(ego_v) - actor_v
+    closing = max(0.0, rel_v) if lon > 0.0 else 0.0
+    if lon > 0.0 and closing > 1.0e-3:
+        ttc = min(30.0, lon / closing)
+    else:
+        ttc = 30.0
+    return [
+        1.0,
+        max(-1.0, min(1.0, lon / 40.0)),
+        max(-1.0, min(1.0, lat / 8.0)),
+        max(0.0, min(1.0, actor_v / 20.0)),
+        max(-1.0, min(1.0, rel_v / 20.0)),
+        max(0.0, min(1.0, closing / 20.0)),
+        max(0.0, min(1.0, ttc / 30.0)),
+        1.0 if lon > 0.0 else -1.0,
+    ]
+
+
