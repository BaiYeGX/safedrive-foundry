<?xml version="1.0" encoding="UTF-8"?>
<OpenDRIVE>
  <header revMajor="1" revMinor="4" name="Town10HD" north="500" south="0" east="500" west="0"/>
  <road name="HighwayIn" length="120.0" id="20" junction="-1">
