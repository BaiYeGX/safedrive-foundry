* text=auto

# Archived bytes are frozen recovery material; do not reinterpret historical
# whitespace as an active-tree defect.
archive/** -whitespace

# Linux/WSL source files
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.cfg text eol=lf
sdf text eol=lf

# Windows scripts
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.pptx binary
*.doc binary
*.docx binary
*.dll binary
*.pyd binary
*.exe binary
*.zip binary
